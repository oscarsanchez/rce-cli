        "Use `rce device retire <device>` to rename it as retired and drop its Device Name.",
    )


MARKS = (("base", "base"), ("live", "live"), ("dev_snapshot", "dev"))  # list's flag columns


def cmd_snapshot_list(args: argparse.Namespace) -> None:
    ref = resolve_device(args.device)
    dev = dev_snapshot_id(ref)
    snapshots = [
        snapshot_view(s, dev) for s in CoreAPI().get(f"/devices/{ref.id}/snapshots", items=0)
    ]
    rows = [["ID", "NAME", "CREATED", "READY", "BASE", "LIVE", "DEV"]] + [
        [str(s["id"]), s["name"], s["created_at"], "yes" if s["ready"] else "no"]
        + [word if s[key] else "-" for key, word in MARKS]
        for s in snapshots
    ]
    emit(args, snapshots, table(rows))


