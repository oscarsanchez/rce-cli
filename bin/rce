        f"Snapshot {snapshot['id']} ({snapshot['name']!r}) is now the Dev Snapshot of "
        f"{ref.display}.",
    )


ANSI_ESCAPE = re.compile(r"\x1b\[[0-?]*[ -/]*[@-~]")


def cmd_console(args: argparse.Namespace) -> None:
    try:
        until = re.compile(args.until) if args.until is not None else None
    except re.error as error:
        raise RceError(USAGE, f"--until is not a valid regex: {error}")
    ref = resolve_device(args.device)
    api = CoreAPI()
    run = current_run(api, ref)
    deadline = None if args.timeout is None else time.monotonic() + args.timeout
    for line in console_lines(api, ref, run, deadline):
        if args.strip_ansi:
            line = ANSI_ESCAPE.sub("", line)
        matched = until is not None and until.search(line) is not None
        shown = json.dumps({"line": line, "matched": matched}) if args.json else line
        print(shown, flush=True)
        if matched:
            return
    if until is not None:
        raise RceError(TIMEOUT, f"no console line matched {args.until!r} in {args.timeout:g} s")
    raise RceError(TIMEOUT, f"stopped reading the console after {args.timeout:g} s")


def cmd_forward(args: argparse.Namespace) -> None:
    if args.port in HTTP_ONLY_PORTS:
        raise RceError(
            USAGE,
            f"port {args.port} is HTTP only on RCE, so it can't be forwarded: "
            f"use `rce {HTTP_ONLY_PORTS[args.port]}`.",
        )
    if args.port not in FORWARD_PORTS:
        ports = ", ".join(map(str, FORWARD_PORTS))
        raise RceError(USAGE, f"port {args.port} can't be forwarded; RCE bridges {ports}.")
    local = args.port if args.local is None else args.local
    ref = resolve_device(args.device)
    api = CoreAPI()
    run = current_run(api, ref)
    api.check_reach(bridge_url(run, args.port))  # before listening, not per connection
    what = f"forward to port {args.port}"
    try:
        server = socket.create_server(("127.0.0.1", local))
    except OSError as error:
        raise RceError(
            USAGE, f"cannot listen on 127.0.0.1:{local}: {error.strerror}. Pick another --local."
        )
    with server:
        local = server.getsockname()[1]
        emit(
            args,
            {"id": ref.id, "device_name": ref.name, "port": args.port, "local": local},
            f"Forwarding 127.0.0.1:{local} to port {args.port} of "
            f"{ref.display}. Press Ctrl-C to stop.",
        )
        sys.stdout.flush()
        ended = start_forwarding(api, ref, run, args.port, server)
        while True:  # until interrupted, or the Run ends
            try:
                raise ended.get(timeout=RUN_CHECK_SECONDS)
            except queue.Empty:
                closed = bridge_closed(api, ref, what)
                if closed.code == REFUSED:
                    raise closed


# -- selftest ------------------------------------------------------------------

SELFTEST_MINUTES = 5  # what a selftest Run takes, start to stop, about
SELFTEST_MAX_RUNTIME = 600  # seconds: the cap on its Run, should the stop fail
SELFTEST_STEP_TIMEOUT = 60  # seconds for the console and forward steps to see the marker
SELFTEST_STEPS = (
    "start", "device-info", "sideload", "launch", "console", "screenshot", "forward", "stop"
)


def selftest_app(marker: str) -> bytes:
    """A tiny dev app, zipped: it shows a screen and prints `marker` every second."""
    manifest = "title=rce selftest\nmajor_version=1\nminor_version=0\nbuild_version=1\n"
    main = f"""sub Main()
    screen = CreateObject("roSGScreen")
    port = CreateObject("roMessagePort")
    screen.SetMessagePort(port)
    scene = screen.CreateScene("Scene")
    banner = scene.CreateChild("Label")
    banner.text = "{marker}"
    banner.translation = [100, 100]
    screen.Show()
    while true
        print "{marker}"
        msg = wait(1000, port)
        if type(msg) = "roSGScreenEvent" and msg.IsScreenClosed() then return
    end while
end sub
"""
    archive = io.BytesIO()
    with zipfile.ZipFile(archive, "w", zipfile.ZIP_DEFLATED) as app:
        app.writestr("manifest", manifest)
        app.writestr("source/main.brs", main)
    return archive.getvalue()


def read_forwarded(local: tuple[str, int], marker: str, timeout: float) -> bool:
    """Whether a local TCP connection to `local` reads `marker` within `timeout`."""
    deadline, seen = time.monotonic() + timeout, b""
    with socket.create_connection(local, timeout=timeout) as client:
        while marker.encode() not in seen:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return False
            client.settimeout(remaining)
            try:
                chunk = client.recv(65536)
            except TimeoutError:
                return False
            if not chunk:
                return False
            seen = seen[-len(marker):] + chunk
    return True


def selftest_device(args: argparse.Namespace) -> DeviceRef:
    """--device, or the only Device Name; exit 2 when that is ambiguous."""
    if args.device is not None:
        return resolve_device(args.device)
    names = sorted(device_entries())
    if len(names) != 1:
        known = f" (Device Names: {', '.join(names)})" if names else ""
        raise RceError(USAGE, f"pick the Cloud Device to test with --device NAME{known}")
    return resolve_device(names[0])


def cmd_selftest(args: argparse.Namespace) -> None:
    if not args.live:
        raise RceError(
            USAGE,
            "the offline tests are the pytest suite (`uv run pytest`, or `scripts/check` with "
            "the lints) in the roku-rce repo. `rce selftest --live` tests a real Cloud Device "
            "and costs device-minutes.",
        )
    ref = selftest_device(args)
    dev_password(ref)  # before any cost: sideload and screenshot need it
    name = ref.display
    confirm(
        args,
        f"Start a Run of {name} for the selftest? It takes about {SELFTEST_MINUTES} min "
        f"(about {usd(SELFTEST_MINUTES * USD_PER_MINUTE)} at {usd(USD_PER_MINUTE * 60)}/h), "
        f"capped at {SELFTEST_MAX_RUNTIME // 60} min "
        f"({usd(SELFTEST_MAX_RUNTIME / 60 * USD_PER_MINUTE)}). "
        "It installs a test app as the dev app, and stops the Run at the end.",
    )
    api = CoreAPI()
    steps: list[dict] = []
    marker = f"rce-selftest-{secrets.token_hex(4)}"

    def report(passed: bool) -> dict:
        return {"id": ref.id, "device_name": ref.name, "passed": passed, "steps": steps}

    def step(title: str, action) -> None:
        """Run one step and report it; a failing step ends the selftest."""
        number = SELFTEST_STEPS.index(title) + 1
        try:
            detail = action()
        except RceError as error:
            steps.append({"step": title, "ok": False, "detail": str(error)})
            if not args.json:
                print(f"FAIL {number} {title}: {error}", flush=True)
            raise
        steps.append({"step": title, "ok": True, "detail": detail})
        if not args.json:
            print(f"ok   {number} {title}: {detail}", flush=True)

    def start() -> str:
        run = start_run(api, ref, StartOptions(max_runtime=SELFTEST_MAX_RUNTIME))["running_device"]
        return f"Run {run['id']} of {name} takes input"

    def info() -> str:
        found = device_info(ecp(api, ref, "query/device-info"))
        dev = "on" if found.get("developer-enabled") else "off"
        return (
            f"Roku OS {found.get('software-version')} build {found.get('software-build')}, "
            f"developer mode {dev}, ECP {found.get('ecp-setting-mode')}"
        )

    def sideload() -> str:
        archive = selftest_app(marker)
        outcome = install_app(Installer.open(api, ref), "rce-selftest.zip", archive)
        return f"{outcome} a test app ({len(archive)} bytes) that prints {marker}"

    def launch() -> str:
        ecp(api, ref, "launch/dev", "POST")
        return "launched the dev app"

    def console() -> str:
        deadline = time.monotonic() + SELFTEST_STEP_TIMEOUT
        run = current_run(api, ref)
        if not any(marker in line for line in console_lines(api, ref, run, deadline)):
            raise RceError(TIMEOUT, f"the console showed no {marker} in {SELFTEST_STEP_TIMEOUT} s")
        return f"read {marker} on port {CONSOLE_PORT}"

    def screenshot() -> str:
        return f"{len(take_screenshot(Installer.open(api, ref)))} bytes"

    def forward() -> str:
        run = current_run(api, ref)
        with socket.create_server(("127.0.0.1", 0)) as server:
            start_forwarding(api, ref, run, CONSOLE_PORT, server)
            local = server.getsockname()
            if not read_forwarded(local, marker, SELFTEST_STEP_TIMEOUT):
                raise RceError(
                    TIMEOUT,
                    f"127.0.0.1:{local[1]} read no {marker} in {SELFTEST_STEP_TIMEOUT} s",
                )
        return f"read {marker} through 127.0.0.1:{local[1]}"

    def stop() -> str:
        report = run_report(get_device(api, ref), ref.name)
        stop_run(api, ref, wait=True)
        return (
            f"Run {report['run']['id']} ran {report['elapsed_s'] // 60} min, "
            f"about {usd(report['elapsed_cost_usd'])}; {name} is shut down"
        )

    with device_lock(ref, args.wait_lock):
        try:
            step("start", start)  # a start that fails stops its own Run
            try:
                for title, action in zip(
                    SELFTEST_STEPS[1:-1], (info, sideload, launch, console, screenshot, forward)
                ):
                    step(title, action)
            finally:  # a failed step or Ctrl-C too: the Run must not keep billing
                step("stop", stop)
        except RceError as error:
            if args.json:
                print(json.dumps(report(passed=False), indent=2))
            failed = next(s["step"] for s in steps if not s["ok"])
            raise RceError(error.code, f"selftest failed at {failed}: {error}")
    passed = f"All {len(steps)} steps passed on {name}."
    emit(args, report(passed=True), passed)


def parser() -> argparse.ArgumentParser:
    output = argparse.ArgumentParser(add_help=False)
    output.add_argument("--json", action="store_true", help="print JSON for scripts")

    root = argparse.ArgumentParser(prog="rce", description="Use Roku Cloud Emulator.")
    root.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    areas = root.add_subparsers(dest="area", required=True)

    token = areas.add_parser("token", help="the RCE token rce shares with rk")
    token_cmds = token.add_subparsers(dest="command", required=True)
    setting = token_cmds.add_parser(
        "set", parents=[output], help="store the token from a hidden prompt or stdin"
    )
    setting.add_argument("argument", nargs="*", help=argparse.SUPPRESS)  # refused, not echoed
    setting.set_defaults(func=cmd_token_set)
    checking = token_cmds.add_parser(
        "status", parents=[output], help="who the token belongs to, its expiry, trial minutes"
    )
    checking.set_defaults(func=cmd_token_status)

    device = areas.add_parser("device", help="Cloud Devices and Runs")
    device_cmds = device.add_subparsers(dest="command", required=True)
    listing = device_cmds.add_parser("list", parents=[output], help="list Cloud Devices")
    listing.add_argument("--running", action="store_true", help="only Cloud Devices with a Run")
    listing.add_argument(
        "--pool", action="store_true", help=f"only the Pool's members (${POOL_VAR}) and how many are free"
    )
    listing.set_defaults(func=cmd_device_list)

    show = device_cmds.add_parser("show", parents=[output], help="one Cloud Device in detail")
    show.add_argument("device", help="Device Name or RCE id")
    show.add_argument(
        "--dev-password",
        action="store_true",
        help="also print its stored Dev Password, bare on stderr, for a pipe into a CI secret",
    )
    show.set_defaults(func=cmd_device_show)

    naming = device_cmds.add_parser(
        "alias", parents=[output], help="give a Cloud Device a Device Name"  # glossary-ok: spec
    )
    naming.add_argument("device", help="Device Name or RCE id")
    naming.add_argument("name", help="the new Device Name")
    naming.add_argument("--force", action="store_true", help="take the name from another device")
    naming.set_defaults(func=cmd_device_alias)

    resolve = device_cmds.add_parser("resolve", parents=[output], help="print a Device Name's id")
    resolve.add_argument("name", help="a Device Name")
    resolve.set_defaults(func=cmd_device_resolve)

    locking = argparse.ArgumentParser(add_help=False)
    locking.add_argument(
        "--wait-lock", action="store_true", help="wait for another rce holding the device lock"
    )

    start = device_cmds.add_parser("start", parents=[output, locking], help="start a Run")
    start.add_argument("device", nargs="?", help="Device Name or RCE id (none with --pool)")
    start.add_argument(
        "--pool", action="store_true", help=f"claim a Free Cloud Device of the Pool (${POOL_VAR})"
    )
    start.add_argument("--snapshot", type=int, help="Snapshot id (default: the Dev Snapshot)")
    start.add_argument("--firmware", help="firmware version id (default: the latest)")
    start.add_argument(
        "--max-runtime", type=int, default=DEFAULT_MAX_RUNTIME, help="cap in seconds"
    )
    start.add_argument(
        "--no-wait", action="store_true", help="return once RCE has given the Run an id"
    )
    start.add_argument(
        "--timeout",
        type=float,
        default=DEFAULT_START_TIMEOUT,
        help="seconds to wait for ready (--no-wait: for the Run)",
    )
    start.set_defaults(func=cmd_device_start)

    stop = device_cmds.add_parser("stop", parents=[output, locking], help="end a Run")
    stop.add_argument("device", help="Device Name or RCE id")
    stop.add_argument(
        "--run", type=int, metavar="ID", help="stop only while this Run is the current one"
    )
    stop.add_argument("--wait", action="store_true", help="wait until it has shut down")
    stop.add_argument(
        "--timeout", type=float, default=DEFAULT_STOP_TIMEOUT, help="seconds to wait (--wait)"
    )
    stop.set_defaults(func=cmd_device_stop)

    status = device_cmds.add_parser(
        "status", parents=[output], help="a Cloud Device's Run: state, cap, elapsed time and cost"
    )
    status.add_argument("device", help="Device Name or RCE id")
    status.set_defaults(func=cmd_device_status)

    console = areas.add_parser(
        "console", parents=[output], help="stream a running Cloud Device's BrightScript console"
    )
    console.add_argument("device", help="Device Name or RCE id")
    console.add_argument("--until", metavar="REGEX", help="exit 0 on the first line that matches")
    console.add_argument(
        "--timeout", type=float, metavar="S", help="exit 5 after S seconds (default: never)"
    )
    console.add_argument(
        "--strip-ansi", action="store_true", help="remove colour codes before printing and matching"
    )
    console.set_defaults(func=cmd_console)

    forward = areas.add_parser(
        "forward",
        parents=[output],
        help="forward a running Cloud Device's TCP port (debuggers, console) to a local port",
    )
    forward.add_argument("device", help="Device Name or RCE id")
    forward.add_argument("port", type=int, help=f"device port: {', '.join(map(str, FORWARD_PORTS))}")
    forward.add_argument(
        "--local", type=int, metavar="N", help="local port on 127.0.0.1 (default: the same)"
    )
    forward.set_defaults(func=cmd_forward)

    usage = areas.add_parser(
        "usage", parents=[output], help="trial minutes used and left, or billed minutes"
    )
    usage.set_defaults(func=cmd_usage)

    yes = argparse.ArgumentParser(add_help=False)
    yes.add_argument("--yes", action="store_true", help="skip the confirmation prompt")

    create = device_cmds.add_parser(
        "create", parents=[output, yes], help="create a Cloud Device (permanent)"
    )
    create.add_argument("name", help="Device Name (also its name on RCE)")
    create.add_argument("--type", required=True, choices=("tv", "stb"), help="device type")
    create.set_defaults(func=cmd_device_create)

    retire = device_cmds.add_parser(
        "retire", parents=[output, yes], help="retire a Cloud Device (RCE can't delete)"
    )
    retire.add_argument("device", help="Device Name or RCE id")
    retire.set_defaults(func=cmd_device_retire)

    setup_dev = device_cmds.add_parser(
        "setup-dev",
        parents=[output, locking, yes],
        help="take a Cloud Device to a Dev Snapshot, pausing where a person must act",
    )
    setup_dev.add_argument("device", help="Device Name or RCE id (it needs a Device Name)")
    setup_dev.add_argument("--restart", action="store_true", help="start over from step 1")
    setup_dev.add_argument(
        "--keep-running", action="store_true", help="leave the Run going at the end or on failure"
    )
    setup_dev.add_argument(
        "--show-password",
        action="store_true",
        help="print the Dev Password once, for you to type it yourself or keep it",
    )
    setup_dev.set_defaults(func=cmd_device_setup_dev)

    delete = device_cmds.add_parser(
        "delete", aliases=["rm"], help="not possible on RCE; see retire"
    )
    delete.add_argument("rest", nargs=argparse.REMAINDER, help=argparse.SUPPRESS)
    delete.set_defaults(func=cmd_device_delete)

    key = areas.add_parser("key", parents=[output], help="press remote keys on a running device")
    key.add_argument("device", help="Device Name or RCE id")
    key.add_argument("keys", nargs="+", metavar="key", help="Home, Select, Up, Lit_a, ...")
    key.add_argument("--delay", type=int, default=0, help="milliseconds between keys")
    key.set_defaults(func=cmd_key)

    query = areas.add_parser("ecp", parents=[output], help="send an ECP command to a running device")
    query.add_argument("device", help="Device Name or RCE id")
    query.add_argument("path", help="ECP path, e.g. query/device-info or query/active-app")
    query.add_argument("--method", choices=("GET", "POST"), default="GET", help="HTTP method")
    query.set_defaults(func=cmd_ecp)

    launch = areas.add_parser("launch", parents=[output], help="launch the dev app on a running device")
    launch.add_argument("device", help="Device Name or RCE id")
    launch.add_argument(
        "--param",
        dest="params",
        action="append",
        default=[],
        type=launch_param,
        metavar="KEY=VALUE",
        help="a launch param (repeatable), URL-encoded for you",
    )
    launch.set_defaults(func=cmd_launch)

    sideload = areas.add_parser(
        "sideload", parents=[output], help="install a zip or RSG package on a running device"
    )
    sideload.add_argument("device", help="Device Name or RCE id")
    sideload.add_argument("file", help="the app's zip, or an RSG package (.bin)")
    sideload.set_defaults(func=cmd_sideload)

    screenshot = areas.add_parser(
        "screenshot", parents=[output], help="save a screenshot of the foreground dev app"
    )
    screenshot.add_argument("device", help="Device Name or RCE id")
    screenshot.add_argument(
        "-o", "--output", required=True, metavar="FILE", help="where to write the JPEG"
    )
    screenshot.set_defaults(func=cmd_screenshot)

    snapshot =areas.add_parser("snapshot", help="a Cloud Device's Snapshots and Dev Snapshot")
    snapshot_cmds = snapshot.add_subparsers(dest="command", required=True)
    snapshots = snapshot_cmds.add_parser(
        "list", parents=[output], help="a Cloud Device's Snapshots, marking the Dev Snapshot"
    )
    snapshots.add_argument("device", help="Device Name or RCE id")
    snapshots.set_defaults(func=cmd_snapshot_list)

    taking = snapshot_cmds.add_parser(
        "take", parents=[output, yes], help="take a Snapshot and wait until it is ready"
    )
    taking.add_argument("device", help="Device Name or RCE id")
    taking.add_argument(
        "--label", dest="snapshot_name", required=True, help="the Snapshot's name"  # glossary-ok: spec flag name
    )
    taking.add_argument(
        "--timeout", type=float, default=DEFAULT_SNAPSHOT_TIMEOUT, help="seconds to wait for ready"
    )
    taking.set_defaults(func=cmd_snapshot_take)

    use_as_dev = snapshot_cmds.add_parser(
        "use-as-dev", parents=[output, yes], help="make a ready Snapshot the Dev Snapshot"
    )
    use_as_dev.add_argument("device", help="Device Name or RCE id")
    use_as_dev.add_argument("snapshot", type=int, help="Snapshot id")
    use_as_dev.set_defaults(func=cmd_snapshot_use_as_dev)

    selftest = areas.add_parser(
        "selftest", parents=[output, locking, yes], help="test rce end to end on a Cloud Device"
    )
    selftest.add_argument(
        "--live", action="store_true", help="start a real Run (costs device-minutes)"
    )
    selftest.add_argument(
        "--device", help="Device Name or RCE id (default: the only Device Name)"
    )
    selftest.set_defaults(func=cmd_selftest)
    return root


def main(argv: list[str]) -> int:
    args = parser().parse_args(argv)
    try:
        args.func(args)
    except RceError as error:
        print(f"rce: {error}", file=sys.stderr)
        return error.code
    except KeyboardInterrupt:  # any Run it started is stopped on the way out
        print("rce: interrupted", file=sys.stderr)
        return INTERRUPTED
    return OK


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
