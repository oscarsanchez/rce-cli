#!/usr/bin/env python3
"""Run a command on a pseudo-terminal so an agent can answer its prompts.

usage: scripts/tty-drive LOG FIFO -- command [args...]

The command's output goes to LOG. Each line written to FIFO (created if missing)
is typed into the command, followed by Enter; a line `\\x03` sends Ctrl-C.
When the command exits, LOG ends with `[tty-drive] exit status N` and tty-drive
exits with that status. Use it only to give an answer the user has approved
(see docs/agents/live-rce.md).
"""
import os
import pty
import select
import signal
import sys

if len(sys.argv) < 5 or sys.argv[3] != "--":
    sys.exit(__doc__.strip().splitlines()[2])
log_path, fifo_path, cmd = sys.argv[1], sys.argv[2], sys.argv[4:]
if not os.path.exists(fifo_path):
    os.mkfifo(fifo_path)

pid, fd = pty.fork()
if pid == 0:
    os.execvp(cmd[0], cmd)

fifo = os.open(fifo_path, os.O_RDWR | os.O_NONBLOCK)  # RDWR: stays open with no writer
status = 1
with open(log_path, "ab", buffering=0) as log:
    while True:
        ready, _, _ = select.select([fd, fifo], [], [], 1.0)
        if fd in ready:
            try:
                data = os.read(fd, 4096)
            except OSError:  # the command closed its terminal
                data = b""
            if data:
                log.write(data)
        if fifo in ready:
            for line in os.read(fifo, 4096).decode().splitlines():
                if line == "\\x03":
                    os.kill(pid, signal.SIGINT)
                else:
                    os.write(fd, (line + "\r").encode())
        done, raw = os.waitpid(pid, os.WNOHANG)
        if done:
            status = os.waitstatus_to_exitcode(raw)
            log.write(f"\n[tty-drive] exit status {status}\n".encode())
            break
sys.exit(status if status >= 0 else 128 - status)
